                        <th>Ù†ÙˆØ¹ Ù¾Ø±Ø¯Ø§Ø®Øª</th>
                        <th>Ù…Ø¨Ù„Øº</th>
                        <th>ÙˆØ¶Ø¹ÛŒØª</th>
                        <th>ØªØ§Ø±ÛŒØ® Ø§Ø±Ø³Ø§Ù„</th>
                        <th>ØªØ§Ø±ÛŒØ® Ø¨Ø±Ø±Ø³ÛŒ</th>
                        <th>ÙÛŒØ´</th>
                        <th>Ø¹Ù…Ù„ÛŒØ§Øª</th>
                    </tr>
                </thead>
