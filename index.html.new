    <script>
        // Check if user is logged in
        async function checkAuth() {
            try {
                const res = await fetch('/trips', {
                    method: 'GET',
                    credentials: 'include'
                });
                
                if (res.ok) {
                    window.isLoggedIn = true;
                } else {
                    window.isLoggedIn = false;
                    showLoginModal();
                }
            } catch (err) {
                window.isLoggedIn = false;
                showLoginModal();
            }
        }

        // Show login modal
        function showLoginModal() {
            document.getElementById('loginModal').style.display = 'block';
            window.isLoggedIn = false;
        }

        // Hide login modal
        function hideLoginModal() {
            document.getElementById('loginModal').style.display = 'none';
            window.isLoggedIn = true;
        }

        // Handle login form submission
        document.getElementById('loginFormElement').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            
            try {
                const res = await fetch('/login', {
                    method: 'POST',
                    headers: {
                 'Content-Type': 'application/x-www-form-urlencoded',
                },
                    body: new URLSearchParams({
                        'username': username,
                        'password': password
                    }),
                    credentials: 'include'
                });
                
                if (res.ok) {
                    hideLoginModal();
                    syncData();
                } else {
                    alert('Ù†Ø§Ù… Ú©Ø§Ø±Ø¨Ø±ÛŒ ÛŒØ§ Ø±Ù…Ø² Ø¹Ø¨ÙˆØ± Ø§Ø´ØªØ¨Ø§Ù‡ Ø§Ø³Øª.');
                }
            } catch (err) {
                alert('Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.');
            }
        });

        // Add logout button to sync bar
        const syncBar = document.querySelector('.sync-bar');
        if (syncBar) {
            const logoutBtn = document.createElement('button');
            logoutBtn.textContent = 'Ø®Ø±ÙˆØ¬';
            logoutBtn.className = 'btn-logout';
            logoutBtn.style.marginRight = '10px';
            logoutBtn.style.backgroundColor = '#f44336';
            logoutBtn.style.color = 'white';
            logoutBtn.style.border = 'none';
            logoutBtn.style.padding = '8px 16px';
            logoutBtn.style.borderRadius = '6px';
            logoutBtn.style.cursor = 'pointer';
            
            logoutBtn.addEventListener('click', async () => {
                try {
                    const res = await fetch('/logout', {
                        method: 'POST',
                        credentials: 'include'
                    });
                    
                    if (res.ok) {
                        showLoginModal();
                    }
                } catch (err) {
                    alert('Ø®Ø·Ø§ Ø¯Ø± Ø®Ø±ÙˆØ¬ Ø§Ø² Ø³ÛŒØ³ØªÙ….');
                }
            });
            
            syncBar.appendChild(logoutBtn);
        }

        // Check auth on page load
        document.addEventListener('DOMContentLoaded', checkAuth);
    </script>
