<!-- Modal Ù„ÛŒØ³Øª Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù† Ù‡Ø± ØªÙˆØ± -->
<div class="modal-overlay" id="tripParticipantsModal" onclick="closeTripParticipantsModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
        <button class="modal-close" onclick="closeTripParticipantsModal()">âœ•</button>
        <h2 id="tripParticipantsTitle" style="margin-top: 0; color: var(--primary);">Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù† ØªÙˆØ±</h2>
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Ø±Ø¯ÛŒÙ</th>
                        <th>Ù†Ø§Ù… Ùˆ Ù†Ø§Ù… Ø®Ø§Ù†ÙˆØ§Ø¯Ú¯ÛŒ</th>
                        <th>Ú©Ø¯ Ù…Ù„ÛŒ</th>
                        <th>Ø´Ù…Ø§Ø±Ù‡ Ù…ÙˆØ¨Ø§ÛŒÙ„</th>
                        <th>Ù†ÙˆØ¹ Ø±ÙØªâ€ŒÙˆØ¢Ù…Ø¯</th>
                        <th>ÙˆØ¶Ø¹ÛŒØª Ù¾Ø±Ø¯Ø§Ø®Øª</th>
                        <th>Ù…Ø¨Ù„Øº Ø¯Ø±ÛŒØ§ÙØªÛŒ</th>
                        <th>Ù…Ø¨Ù„Øº Ø¨Ø§Ù‚ÛŒâ€ŒÙ…Ø§Ù†Ø¯Ù‡</th>
                    </tr>
