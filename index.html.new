            </table>
        </div>
        <div id="tripParticipantsStatus" class="payments-loading">Ø¯Ø± Ø­Ø§Ù„ Ø¯Ø±ÛŒØ§ÙØª Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†...</div>
    </div>
</div>

<script>
    let db;
    let isServerOnline = true;
    let allTrips = [];
    let allParticipants = [];

    // Û±. Ø±Ø§Ù‡ Ø§Ù†Ø¯Ø§Ø²ÛŒ IndexedDB
    const request = indexedDB.open("AbarhamSyncDB", 2);

    request.onupgradeneeded = (e) => {
        db = e.target.result;
        if (!db.objectStoreNames.contains("trips")) db.createObjectStore("trips", { keyPath: "id" });
        if (!db.objectStoreNames.contains("participants")) db.createObjectStore("participants", { keyPath: "id" });
    };

    request.onsuccess = (e) => {
        db = e.target.result;
        checkServerStatus().then(() => {
            syncData();
            if (isServerOnline) loadPayments();
        });
        setInterval(checkServerStatus, 5000);
    };

    request.onerror = () => {
        console.error("Ø®Ø·Ø§ Ø¯Ø± Ø±Ø§Ù‡â€ŒØ§Ù†Ø¯Ø§Ø²ÛŒ IndexedDB");
        checkServerStatus().then(syncData);
    };

    // Û². Ø¨Ø±Ø±Ø³ÛŒ ÙˆØ¶Ø¹ÛŒØª Ø§ØªØµØ§Ù„
    async function checkServerStatus() {
        const badge = document.getElementById('connectionStatus');
        try {
            const res = await fetch('/health', { cache: 'no-store', credentials: 'include' });
            if (res.ok) {
                isServerOnline = true;
                if (badge) {
                    badge.textContent = 'Ø¢Ù†Ù„Ø§ÛŒÙ† (Ù…ØªØµÙ„ Ø¨Ù‡ Ø³Ø±ÙˆØ±)';
                    badge.style.backgroundColor = '#2e7d32';
                    badge.style.color = '#ffffff';
                }
            } else if (res.status === 401) {
                isServerOnline = true;
                if (badge) {
                    badge.textContent = 'Ø¢Ù†Ù„Ø§ÛŒÙ† (Ù†ÛŒØ§Ø² Ø¨Ù‡ ÙˆØ±ÙˆØ¯)';
                    badge.style.backgroundColor = '#ff9800';
                    badge.style.color = '#ffffff';
                }
                showLoginModal();
            } else {
                throw new Error('Server error');
            }
        } catch (err) {
            isServerOnline = false;
            if (badge) {
                badge.textContent = 'Ø­Ø§Ù„Øª Ø¢ÙÙ„Ø§ÛŒÙ† (Ø°Ø®ÛŒØ±Ù‡ Ù…Ø­Ù„ÛŒ)';
                badge.style.backgroundColor = '#c62828';
                badge.style.color = '#ffffff';
            }
        }
    }

    // Û³. Ø«Ø¨Øª Ùˆ ÙˆÛŒØ±Ø§ÛŒØ´ ØªÙˆØ± (ÛŒÚ©Ù¾Ø§Ø±Ú†Ù‡)
    async function handleTripSubmit(e) {
        e.preventDefault();

        if (!isServerOnline) {
            alert("Ø¨Ø±Ø§ÛŒ Ø«Ø¨Øª ÛŒØ§ ÙˆÛŒØ±Ø§ÛŒØ´ Ø§Ø·Ù„Ø§Ø¹Ø§Øª Ø¨Ø§ÛŒØ¯ Ø¨Ù‡ Ø§ÛŒÙ†ØªØ±Ù†Øª Ù…ØªØµÙ„ Ø¨Ø§Ø´ÛŒØ¯.");
            return;
        }

        const tripId = document.getElementById('t_id').value;
        const tripData = {
            title: document.getElementById('t_title').value,
            destination: document.getElementById('t_dest').value,
            date: document.getElementById('t_date').value,
            price: parseFloat(document.getElementById('t_price').value) || 0,
            capacity: parseInt(document.getElementById('t_capacity').value) || 0,
            telegram_group_link: document.getElementById('t_group').value || null,
            has_car_option: document.getElementById('t_has_car_option').checked,
            car_fee: parseInt(document.getElementById('t_car_fee').value) || 0
        };

        const method = tripId ? 'PUT' : 'POST';
        const url = tripId ? `/trips/${tripId}` : '/trips';

        try {
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
credentials: 'include',
credentials: 'include',
                body: JSON.stringify(tripData)
            });

            if (res.ok) {
                alert(tripId ? "ØªÙˆØ± Ø¨Ø±ÙˆØ²Ø±Ø³Ø§Ù†ÛŒ Ø´Ø¯!" : "ØªÙˆØ± Ø¬Ø¯ÛŒØ¯ Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª Ø«Ø¨Øª Ø´Ø¯!");
                resetTripForm();
                syncData();
            } else {
                const errData = await res.json();
                alert("Ø®Ø·Ø§ Ø¯Ø± Ø«Ø¨Øª ØªÙˆØ±: " + JSON.stringify(errData));
            }
        } catch (err) {
            alert("Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.");
        }
    }

    // Û´. Ø«Ø¨Øª Ùˆ ÙˆÛŒØ±Ø§ÛŒØ´ Ù…Ø³Ø§ÙØ± (ÛŒÚ©Ù¾Ø§Ø±Ú†Ù‡)
    async function handleParticipantSubmit(e) {
        e.preventDefault();

        if (!isServerOnline) {
            alert("Ø¨Ø±Ø§ÛŒ Ø«Ø¨Øª ÛŒØ§ ÙˆÛŒØ±Ø§ÛŒØ´ Ø§Ø·Ù„Ø§Ø¹Ø§Øª Ø¨Ø§ÛŒØ¯ Ø¨Ù‡ Ø§ÛŒÙ†ØªØ±Ù†Øª Ù…ØªØµÙ„ Ø¨Ø§Ø´ÛŒØ¯.");
            return;
        }

        const tripId = document.getElementById('p_trip_id').value;
        if (!tripId) {
            alert("Ù„Ø·ÙØ§Ù‹ Ø§Ø¨ØªØ¯Ø§ ÛŒÚ© ØªÙˆØ± Ø§Ù†ØªØ®Ø§Ø¨ Ú©Ù†ÛŒØ¯.");
            return;
        }

        const participantId = document.getElementById('p_id').value;
        const participantData = {
            full_name: document.getElementById('p_name').value,
            national_id: document.getElementById('p_national_id').value,
            phone_number: document.getElementById('p_phone').value,
            trip_id: parseInt(tripId),
            payment_status: document.getElementById('p_status').value,
            paid_amount: parseFloat(document.getElementById('p_paid').value) || 0
        };

        const method = participantId ? 'PUT' : 'POST';
        const url = participantId ? `/participants/${participantId}` : '/participants';

        try {
            const res = await fetch(url, {
               method: method,
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(participantData)
        });

            if (res.ok) {
                alert(participantId ? "Ø§Ø·Ù„Ø§Ø¹Ø§Øª Ù…Ø³Ø§ÙØ± Ø¨Ø±ÙˆØ²Ø±Ø³Ø§Ù†ÛŒ Ø´Ø¯!" : "Ù…Ø³Ø§ÙØ± Ø¬Ø¯ÛŒØ¯ Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª Ø«Ø¨Øª Ø´Ø¯!");
                resetParticipantForm();
                syncData();
            } else {
                const errData = await res.json();
                alert("Ø®Ø·Ø§ Ø¯Ø± Ø«Ø¨Øª Ù…Ø³Ø§ÙØ±: " + JSON.stringify(errData));
            }
        } catch (err) {
            alert("Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.");
        }
    }

    // Ûµ. Ø­Ø°Ù ØªÙˆØ±
    async function deleteTrip(id) {
        if (!confirm("Ø¢ÛŒØ§ Ø§Ø² Ø­Ø°Ù Ø§ÛŒÙ† ØªÙˆØ± Ùˆ ØªÙ…Ø§Ù… Ù…Ø³Ø§ÙØ±Ø§Ù† Ø¢Ù† Ø§Ø·Ù…ÛŒÙ†Ø§Ù† Ø¯Ø§Ø±ÛŒØ¯ØŸ")) return;
        if (!isServerOnline) {
            alert("Ø¨Ø±Ø§ÛŒ Ø­Ø°Ù Ø¨Ø§ÛŒØ¯ Ø¨Ù‡ Ø³Ø±ÙˆØ± Ù…ØªØµÙ„ Ø¨Ø§Ø´ÛŒØ¯.");
            return;
        }
        try {
            const res = await fetch(`/trips/${id}`, { method: 'DELETE', credentials: 'include' });
            if (res.ok) {
                alert("ØªÙˆØ± Ø­Ø°Ù Ø´Ø¯!");
                syncData();
            } else {
                alert("Ø®Ø·Ø§ Ø¯Ø± Ø­Ø°Ù ØªÙˆØ±.");
            }
        } catch (err) {
            alert("Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.");
        }
    }

    // Û¶. Ø­Ø°Ù Ù…Ø³Ø§ÙØ±
    async function deleteParticipant(id) {
        if (!confirm("Ø¢ÛŒØ§ Ø§Ø² Ø­Ø°Ù Ø§ÛŒÙ† Ù…Ø³Ø§ÙØ± Ø§Ø·Ù…ÛŒÙ†Ø§Ù† Ø¯Ø§Ø±ÛŒØ¯ØŸ")) return;
        if (!isServerOnline) {
            alert("Ø¨Ø±Ø§ÛŒ Ø­Ø°Ù Ø¨Ø§ÛŒØ¯ Ø¨Ù‡ Ø³Ø±ÙˆØ± Ù…ØªØµÙ„ Ø¨Ø§Ø´ÛŒØ¯.");
            return;
        }
        try {
            const res = await fetch(`/participants/${id}`, { method: 'DELETE', credentials: 'include' });
            if (res.ok) {
                alert("Ù…Ø³Ø§ÙØ± Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª Ø­Ø°Ù Ø´Ø¯.");
                syncData();
            } else {
                alert("Ø®Ø·Ø§ Ø¯Ø± Ø­Ø°Ù Ù…Ø³Ø§ÙØ±.");
            }
        } catch (err) {
            alert("Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.");
        }
    }

    // Û·. ÙˆÛŒØ±Ø§ÛŒØ´ ØªÙˆØ± â€” Ù¾Ø± Ú©Ø±Ø¯Ù† ÙØ±Ù… Ø¨Ø§ Ø¯Ø§Ø¯Ù‡â€ŒÙ‡Ø§ÛŒ Ù…ÙˆØ¬ÙˆØ¯
    function editTrip(id) {
        const trip = allTrips.find(t => t.id === id);
        if (!trip) return;

        document.getElementById('t_id').value = trip.id;
        document.getElementById('t_title').value = trip.title || '';
        document.getElementById('t_dest').value = trip.destination || '';
        document.getElementById('t_date').value = trip.date || '';
        document.getElementById('t_price').value = trip.price || 0;
        document.getElementById('t_capacity').value = trip.capacity || 0;
        document.getElementById('t_group').value = trip.telegram_group_link || '';
document.getElementById('t_has_car_option').checked = trip.has_car_option || false;
         document.getElementById('t_car_fee').value = trip.car_fee || 0;

        document.getElementById('tripFormTitle').textContent = 'Û±. ÙˆÛŒØ±Ø§ÛŒØ´ ØªÙˆØ±';
        document.getElementById('t_btn').textContent = 'Ø°Ø®ÛŒØ±Ù‡ ØªØºÛŒÛŒØ±Ø§Øª';
        document.getElementById('t_cancel_btn').style.display = 'block';

        document.getElementById('tripForm').scrollIntoView({ behavior: 'smooth' });
    }

    // Û¸. ÙˆÛŒØ±Ø§ÛŒØ´ Ù…Ø³Ø§ÙØ± â€” Ù¾Ø± Ú©Ø±Ø¯Ù† ÙØ±Ù… Ø¨Ø§ Ø¯Ø§Ø¯Ù‡â€ŒÙ‡Ø§ÛŒ Ù…ÙˆØ¬ÙˆØ¯
    function editParticipant(id) {
        const p = allParticipants.find(p => p.id === id);
        if (!p) return;

        document.getElementById('p_id').value = p.id;
        document.getElementById('p_trip_id').value = p.trip_id;
        document.getElementById('p_name').value = p.full_name || '';
        document.getElementById('p_national_id').value = p.national_id || '';
        document.getElementById('p_phone').value = p.phone_number || '';
        document.getElementById('p_status').value = p.payment_status || 'Ù¾Ø±Ø¯Ø§Ø®Øª Ø¨ÛŒØ¹Ø§Ù†Ù‡';
        document.getElementById('p_paid').value = p.paid_amount || 0;

        document.getElementById('participantFormTitle').textContent = 'Û². ÙˆÛŒØ±Ø§ÛŒØ´ Ù…Ø³Ø§ÙØ±';
        document.getElementById('p_btn').textContent = 'Ø°Ø®ÛŒØ±Ù‡ ØªØºÛŒÛŒØ±Ø§Øª';
        document.getElementById('p_cancel_btn').style.display = 'block';

        document.getElementById('participantForm').scrollIntoView({ behavior: 'smooth' });
    }

    function resetTripForm() {
        document.getElementById('tripForm').reset();
document.getElementById('t_has_car_option').checked = false;
document.getElementById('t_car_fee').value = 0;
        document.getElementById('t_id').value = '';
        document.getElementById('t_capacity').value = 0;
        document.getElementById('tripFormTitle').textContent = 'Û±. Ø«Ø¨Øª ØªÙˆØ± Ø¬Ø¯ÛŒØ¯';
        document.getElementById('t_btn').textContent = 'Ø«Ø¨Øª ØªÙˆØ±';
        document.getElementById('t_cancel_btn').style.display = 'none';
    }

    function resetParticipantForm() {
        document.getElementById('participantForm').reset();
        document.getElementById('p_id').value = '';
        document.getElementById('participantFormTitle').textContent = 'Û². Ø«Ø¨Øªâ€ŒÙ†Ø§Ù… Ù…Ø³Ø§ÙØ± Ø¬Ø¯ÛŒØ¯';
        document.getElementById('p_btn').textContent = 'Ø«Ø¨Øª Ù…Ø³Ø§ÙØ±';
        document.getElementById('p_cancel_btn').style.display = 'none';
    }

    // Û¹. Ø¯Ø±ÛŒØ§ÙØª Ø¯Ø§Ø¯Ù‡â€ŒÙ‡Ø§ Ø§Ø² Ø³Ø±ÙˆØ± Ùˆ Ù†Ù…Ø§ÛŒØ´ Ø±ÙˆÛŒ Ø¬Ø¯ÙˆÙ„
    async function syncData() {
        if (!isServerOnline) {
            loadLocalData();
            return;
        }

        if (!window.isLoggedIn) {
            return;
        }

        try {
            const tripsRes = await fetch('/trips', {
                cache: 'no-store',
                credentials: 'include'
            });
            if (!tripsRes.ok) throw new Error('Failed to fetch trips');
            const trips = await tripsRes.json();
            if (!Array.isArray(trips)) throw new Error('Invalid trips data');

            const partsRes = await fetch('/participants', {
                cache: 'no-store',
                credentials: 'include'
            });
            if (!partsRes.ok) throw new Error('Failed to fetch participants');
            const participants = await partsRes.json();
            if (!Array.isArray(participants)) throw new Error('Invalid participants data');

            allTrips = trips;
            allParticipants = participants;

            if (db) {
                const txTrips = db.transaction("trips", "readwrite");
                txTrips.objectStore("trips").clear();
                trips.forEach(t => txTrips.objectStore("trips").put(t));

                const txParts = db.transaction("participants", "readwrite");
                txParts.objectStore("participants").clear();
                participants.forEach(p => txParts.objectStore("participants").put(p));
            }

            renderTrips();
            renderParticipants();
            if (isServerOnline) loadPayments();
        } catch (err) {
            console.error("Ø®Ø·Ø§ Ø¯Ø± Ø¯Ø±ÛŒØ§ÙØª Ø¯Ø§Ø¯Ù‡â€ŒÙ‡Ø§:", err);
            loadLocalData();
        }
    }

    function loadLocalData() {
        if (!db) return;
        const txTrips = db.transaction("trips", "readonly");
        txTrips.objectStore("trips").getAll().onsuccess = (e) => {
            allTrips = e.target.result;
            const txParts = db.transaction("participants", "readonly");
            txParts.objectStore("participants").getAll().onsuccess = (e2) => {
                allParticipants = e2.target.result;
                renderTrips();
                renderParticipants();
            };
        };
    }

    function renderTrips() {
        const tripsTable = document.getElementById('tripsTable');
        const completedTripsTable = document.getElementById('completedTripsTable');
        const tripSelect = document.getElementById('p_trip_id');
        if (!tripsTable) return;

        const currentSelection = tripSelect ? tripSelect.value : '';

        tripsTable.innerHTML = '';
        if (completedTripsTable) completedTripsTable.innerHTML = '';
        if (tripSelect) tripSelect.innerHTML = '<option value="">-- Ø§Ù†ØªØ®Ø§Ø¨ ØªÙˆØ± --</option>';

        const activeTrips = allTrips.filter(t => (t.status || 'active') === 'active');
        const completedTrips = allTrips.filter(t => (t.status || 'active') === 'completed');

        // Ø±Ø¯ÛŒÙ Ø³ÙØ±Ù‡Ø§ÛŒ ÙØ¹Ø§Ù„ - Ø¯Ø±ÛŒØ§ÙØª Ø¬Ù…Ø¹ Ø¯Ø±ÛŒØ§ÙØªÛŒ Ø§Ø² Ø³Ø±ÙˆØ±
        const totalReceivedPromises = activeTrips.map(async (t) => {
            try {
                const res = await fetch(`/trips/${t.id}/total_received`, { credentials: 'include' });
                if (res.ok) {
                    const data = await res.json();
                    return { tripId: t.id, total: data.total_received || 0 };
                }
            } catch (err) {
                console.error('Ø®Ø·Ø§ Ø¯Ø± Ø¯Ø±ÛŒØ§ÙØª Ø¬Ù…Ø¹ Ø¯Ø±ÛŒØ§ÙØªÛŒ ØªÙˆØ±:', err);
            }
            return { tripId: t.id, total: 0 };
        });

        Promise.all(totalReceivedPromises).then(totalReceivedArray => {
            const totalReceivedMap = {};
            totalReceivedArray.forEach(item => {
                totalReceivedMap[item.tripId] = item.total;
            });

            activeTrips.forEach((t, index) => {
                const filteredParts = allParticipants.filter(p => p.trip_id === t.id);
                const totalCollected = totalReceivedMap[t.id] !== undefined ? totalReceivedMap[t.id] : 0;
                const capacityText = t.capacity ? `${filteredParts.length} / ${t.capacity}` : `${filteredParts.length} (Ù†Ø§Ù…Ø­Ø¯ÙˆØ¯)`;

            tripsTable.innerHTML += `
                <tr>
                    <td>${index + 1}</td>
                    <td><strong>${t.title}</strong></td>
                    <td>${t.destination || '-'}</td>
                    <td>${t.date || '-'}</td>
                    <td>${(t.price || 0).toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                    <td>${capacityText}</td>
                    <td>${filteredParts.length} Ù†ÙØ±</td>
                    <td style="color: #00796b; font-weight: bold;">${totalCollected.toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                    <td>
                        <button class="btn-action btn-view" onclick="showTripParticipants(${t.id})">ðŸ‘¥ Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†</button>
                        <button class="btn-action btn-edit" onclick="editTrip(${t.id})">ÙˆÛŒØ±Ø§ÛŒØ´</button>
                        <button class="btn-action btn-delete" onclick="deleteTrip(${t.id})">Ø­Ø°Ù</button>
                    </td>
                </tr>
            `;

            // ÙÙ‚Ø· Ø³ÙØ±Ù‡Ø§ÛŒ ÙØ¹Ø§Ù„ Ø¯Ø±Ø§Ù†ØªØ®Ø§Ø¨â€ŒÚ¯Ø± Ø«Ø¨Øªâ€ŒÙ†Ø§Ù… Ù…Ø³Ø§ÙØ± Ø¸Ø§Ù‡Ø± Ø´ÙˆÙ†Ø¯
            if (tripSelect) {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.innerText = t.title;
                tripSelect.appendChild(opt);
            }
        });
        });

        // Ø±Ø¯ÛŒÙ Ø³ÙØ±Ù‡Ø§ÛŒ Ø¨Ø±Ú¯Ø²Ø§Ø±Ø´Ø¯Ù‡ â€” ÙÙ‚Ø· Ù…Ø´Ø§Ù‡Ø¯Ù‡ Ú¯Ø²Ø§Ø±Ø´ (Ø¨Ø¯ÙˆÙ† ÙˆÛŒØ±Ø§ÛŒØ´/Ø­Ø°Ù/Ø«Ø¨Øªâ€ŒÙ†Ø§Ù…)
        if (completedTripsTable) {
            completedTrips.forEach((t) => {
                const filteredParts = allParticipants.filter(p => p.trip_id === t.id);
                completedTripsTable.innerHTML += `
                    <tr>
                        <td><strong>${t.title}</strong></td>
                        <td>${t.destination || '-'}</td>
                        <td>${t.date || '-'}</td>
                        <td>${filteredParts.length} Ù†ÙØ±</td>
                        <td>
                            <button class="btn-action btn-view" onclick="showTripParticipants(${t.id})">ðŸ‘¥ Ú¯Ø²Ø§Ø±Ø´ Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†</button>
                        </td>
                    </tr>
                `;
            });
        }

        if (tripSelect && currentSelection) tripSelect.value = currentSelection;
    }

    function renderParticipants() {
        const table = document.getElementById('participantsTable');
        if (!table) return;

        const searchInput = document.getElementById('searchInput');
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        table.innerHTML = '';

        const filtered = allParticipants.filter(p => {
            if (!query) return true;
            return (
                (p.full_name || '').toLowerCase().includes(query) ||
                (p.national_id || '').toLowerCase().includes(query) ||
                (p.phone_number || '').toLowerCase().includes(query)
            );
        });

        filtered.forEach(p => {
            const trip = allTrips.find(t => t.id === p.trip_id);
            const tripTitle = trip ? trip.title : 'Ù†Ø§Ù…Ø´Ø®Øµ';
            const badgeClass = p.payment_status === 'Ù¾Ø±Ø¯Ø§Ø®Øª Ú©Ø§Ù…Ù„' ? 'badge-full' : 'badge-deposit';

            table.innerHTML += `
                <tr>
                    <td><strong>${p.full_name}</strong></td>
                    <td>${p.national_id}</td>
                    <td>${p.phone_number || '-'}</td>
                    <td>${tripTitle}</td>
                    <td><span class="badge ${badgeClass}">${p.payment_status || '-'}</span></td>
                    <td>${(p.paid_amount || 0).toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                    <td>
                        <button class="btn-action btn-edit" onclick="editParticipant(${p.id})">ÙˆÛŒØ±Ø§ÛŒØ´</button>
                        <button class="btn-action btn-delete" onclick="deleteParticipant(${p.id})">Ø­Ø°Ù</button>
                    </td>
                </tr>
            `;
        });
    }

    // -----------------------------------------------------------------------
    // Û±Û°. Ø¨Ø±Ø±Ø³ÛŒ Ù¾Ø±Ø¯Ø§Ø®Øªâ€ŒÙ‡Ø§
    // -----------------------------------------------------------------------
    let currentPaymentFilter = '';
    let allPayments = [];

    async function loadPayments() {
        const statusEl = document.getElementById('paymentsStatus');
        const table = document.getElementById('paymentsTable');
        if (!table || !statusEl) return;

        if (!isServerOnline) {
            statusEl.className = 'payments-error';
            statusEl.textContent = 'âŒ Ø¨Ø±Ø§ÛŒ Ù…Ø´Ø§Ù‡Ø¯Ù‡ Ù¾Ø±Ø¯Ø§Ø®Øªâ€ŒÙ‡Ø§ Ø¨Ø§ÛŒØ¯ Ø¨Ù‡ Ø³Ø±ÙˆØ± Ù…ØªØµÙ„ Ø¨Ø§Ø´ÛŒØ¯.';
            return;
        }

        if (!window.isLoggedIn) {
            statusEl.className = 'payments-error';
            statusEl.textContent = 'Ù„Ø·ÙØ§Ù‹ Ø§Ø¨ØªØ¯Ø§ ÙˆØ§Ø±Ø¯ Ø´ÙˆÛŒØ¯.';
            return;
        }

        statusEl.className = 'payments-loading';
        statusEl.textContent = 'Ø¯Ø± Ø­Ø§Ù„ Ø¯Ø±ÛŒØ§ÙØª Ù¾Ø±Ø¯Ø§Ø®Øªâ€ŒÙ‡Ø§...';
        table.innerHTML = '';

        try {
            const url = currentPaymentFilter
                ? `/payments?status=${encodeURIComponent(currentPaymentFilter)}`
                : '/payments';
            const res = await fetch(url, { cache: 'no-store', credentials: 'include' });
            if (!res.ok) throw new Error('Server error');

            allPayments = await res.json();
            renderPayments();
        } catch (err) {
            console.error('Ø®Ø·Ø§ Ø¯Ø± Ø¯Ø±ÛŒØ§ÙØª Ù¾Ø±Ø¯Ø§Ø®Øªâ€ŒÙ‡Ø§:', err);
            statusEl.className = 'payments-error';
            statusEl.textContent = 'âŒ Ø¯Ø±ÛŒØ§ÙØª Ø§Ø·Ù„Ø§Ø¹Ø§Øª Ù¾Ø±Ø¯Ø§Ø®Øªâ€ŒÙ‡Ø§ Ø¨Ø§ Ø®Ø·Ø§ Ù…ÙˆØ§Ø¬Ù‡ Ø´Ø¯.';
        }
    }

    function setPaymentFilter(status) {
        currentPaymentFilter = status;
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.status === status);
        });
        loadPayments();
    }

    function formatPaymentType(type) {
        return type === 'full' ? 'ðŸ’µ Ù¾Ø±Ø¯Ø§Ø®Øª Ú©Ø§Ù…Ù„' : 'ðŸ’° Ø¨ÛŒØ¹Ø§Ù†Ù‡';
    }

    function formatPaymentStatus(status) {
        const map = {
            'pending_review': ['â³ Ø¯Ø± Ø§Ù†ØªØ¸Ø§Ø± Ø¨Ø±Ø±Ø³ÛŒ', 'badge-pending'],
            'confirmed': ['âœ… ØªØ£ÛŒÛŒØ¯ Ø´Ø¯Ù‡', 'badge-confirmed'],
            'rejected': ['âŒ Ø±Ø¯ Ø´Ø¯Ù‡', 'badge-rejected'],

        };
        const [text, cls] = map[status] || [status, ''];
        return `<span class="badge ${cls}">${text}</span>`;
    }

    function getReceiptUrl(payment) {
        // Ø§Ø³ØªØ®Ø±Ø§Ø¬ filename Ø§Ø² receipt_local_path (Ù…Ø«Ù„ receipts/receipt_abc.jpg)
        if (!payment.receipt_local_path) return null;
        const parts = payment.receipt_local_path.split(/[\\/]/);
        const filename = parts[parts.length - 1];
        if (!filename) return null;
        return `/receipts/${encodeURIComponent(filename)}`;
    }

    function renderPayments() {
        const table = document.getElementById('paymentsTable');
        const statusEl = document.getElementById('paymentsStatus');
        if (!table || !statusEl) return;

        table.innerHTML = '';

        if (allPayments.length === 0) {
            statusEl.className = 'payments-empty';
            statusEl.textContent = 'Ù‡ÛŒÚ† Ù¾Ø±Ø¯Ø§Ø®ØªÛŒ Ø¨Ø±Ø§ÛŒ Ù†Ù…Ø§ÛŒØ´ ÙˆØ¬ÙˆØ¯ Ù†Ø¯Ø§Ø±Ø¯.';
            return;
        }

        statusEl.className = 'payments-loading';
        statusEl.textContent = '';

        allPayments.forEach(p => {
            const participantName = p.participant ? (p.participant.full_name || 'Ù†Ø§Ù…Ø´Ø®Øµ') : 'Ù†Ø§Ù…Ø´Ø®Øµ';
            const tripTitle = p.trip ? (p.trip.title || 'Ù†Ø§Ù…Ø´Ø®Øµ') : 'Ù†Ø§Ù…Ø´Ø®Øµ';
            const receiptUrl = getReceiptUrl(p);
            const canReview = p.status === 'pending_review';

            const receiptCell = receiptUrl
                ? `<img class="receipt-thumb" src="${receiptUrl}" alt="ÙÛŒØ´" title="Ù…Ø´Ø§Ù‡Ø¯Ù‡ ÙÛŒØ´" onclick="openReceiptModal('${receiptUrl}')" onerror="this.onerror=null; this.src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg'">`
                : '<span style="color:#9ca3af;">-</span>';

            const actionsCell = canReview
                ? `<button class="btn-action btn-confirm" onclick="confirmPayment(${p.id})">âœ… ØªØ£ÛŒÛŒØ¯</button>
                   <button class="btn-action btn-reject" onclick="rejectPayment(${p.id})">âŒ Ø±Ø¯</button>`
                : '<span style="color:#9ca3af;">-</span>';

            table.innerHTML += `
                <tr>
                    <td>${p.id}</td>
                    <td><strong>${participantName}</strong></td>
                    <td>${tripTitle}</td>
                    <td>${formatPaymentType(p.payment_type)}</td>
                    <td>${(p.expected_amount || 0).toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                    <td>${formatPaymentStatus(p.status)}</td>
                    <td>${p.created_at ? p.created_at.replace('T', ' ').slice(0, 19) : '-'}</td>
                    <td>${p.reviewed_at ? p.reviewed_at.replace('T', ' ').slice(0, 19) : '-'}</td>
                    <td>${receiptCell}</td>
                    <td>${actionsCell}</td>
                </tr>
            `;
        });
    }

    async function confirmPayment(id) {
        if (!confirm('Ø¢ÛŒØ§ Ø§Ø² ØªØ£ÛŒÛŒØ¯ Ø§ÛŒÙ† Ù¾Ø±Ø¯Ø§Ø®Øª Ù…Ø·Ù…Ø¦Ù† Ù‡Ø³ØªÛŒØ¯ØŸ')) return;
        try {
            const res = await fetch(`/payments/${id}/confirm`, { method: 'POST', credentials: 'include' });
            if (res.ok) {
                alert('âœ… Ù¾Ø±Ø¯Ø§Ø®Øª Ø¨Ø§ Ù…ÙˆÙÙ‚ÛŒØª ØªØ£ÛŒÛŒØ¯ Ø´Ø¯.');
                loadPayments();
            } else {
                const errData = await res.json();
                alert('âŒ Ø®Ø·Ø§ Ø¯Ø± ØªØ£ÛŒÛŒØ¯ Ù¾Ø±Ø¯Ø§Ø®Øª: ' + (errData.detail || 'Ø®Ø·Ø§ÛŒ Ù†Ø§Ø´Ù†Ø§Ø®ØªÙ‡'));
            }
        } catch (err) {
            alert('âŒ Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.');
        }
    }

    async function rejectPayment(id) {
        if (!confirm('Ø¢ÛŒØ§ Ø§Ø² Ø±Ø¯ Ú©Ø±Ø¯Ù† Ø§ÛŒÙ† ÙÛŒØ´ Ù…Ø·Ù…Ø¦Ù† Ù‡Ø³ØªÛŒØ¯ØŸ')) return;
        try {
            const res = await fetch(`/payments/${id}/reject`, { method: 'POST', credentials: 'include' });
            if (res.ok) {
                alert('âŒ Ù¾Ø±Ø¯Ø§Ø®Øª Ø±Ø¯ Ø´Ø¯.');
                loadPayments();
            } else {
                const errData = await res.json();
                alert('âŒ Ø®Ø·Ø§ Ø¯Ø± Ø±Ø¯ Ù¾Ø±Ø¯Ø§Ø®Øª: ' + (errData.detail || 'Ø®Ø·Ø§ÛŒ Ù†Ø§Ø´Ù†Ø§Ø®ØªÙ‡'));
            }
        } catch (err) {
            alert('âŒ Ø®Ø·Ø§ Ø¯Ø± Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ±.');
        }
    }

    function openReceiptModal(src) {
        const modal = document.getElementById('receiptModal');
        const img = document.getElementById('receiptModalImg');
        if (!modal || !img) return;
        img.src = src;
        modal.classList.add('show');
    }

    function closeReceiptModal() {
        const modal = document.getElementById('receiptModal');
        if (modal) modal.classList.remove('show');
    }

    // -----------------------------------------------------------------------
    // Û±Û±. Ù†Ù…Ø§ÛŒØ´ Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù† ÛŒÚ© ØªÙˆØ± Ø®Ø§Øµ
    // -----------------------------------------------------------------------
    async function showTripParticipants(tripId) {
        const modal = document.getElementById('tripParticipantsModal');
        const table = document.getElementById('tripParticipantsTable');
        const statusEl = document.getElementById('tripParticipantsStatus');
        const titleEl = document.getElementById('tripParticipantsTitle');
        if (!modal || !table || !statusEl) return;

        const trip = allTrips.find(t => t.id === tripId);
        if (trip) {
            titleEl.textContent = `Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†: ${trip.title}`;
        }

        modal.classList.add('show');
        table.innerHTML = '';
        statusEl.className = 'payments-loading';
        statusEl.textContent = 'Ø¯Ø± Ø­Ø§Ù„ Ø¯Ø±ÛŒØ§ÙØª Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†...';

        try {
            const res = await fetch(`/trips/${tripId}/participants`, { cache: 'no-store', credentials: 'include' });
            if (!res.ok) throw new Error('Server error');

            const participants = await res.json();

            if (participants.length === 0) {
                statusEl.className = 'payments-empty';
                statusEl.textContent = 'Ù‡ÛŒÚ† Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ù‡â€ŒØ§ÛŒ Ø¨Ø±Ø§ÛŒ Ø§ÛŒÙ† ØªÙˆØ± Ø«Ø¨Øª Ù†Ø´Ø¯Ù‡ Ø§Ø³Øª.';
                return;
            }

            statusEl.className = 'payments-loading';
            statusEl.textContent = '';

            participants.forEach((p, index) => {
                // ÙˆØ¶Ø¹ÛŒØª ÙˆØ§Ù‚Ø¹ÛŒ Ù¾Ø±Ø¯Ø§Ø®Øª
                let badgeClass = 'badge-deposit';
                if (p.payment_status === 'Ù¾Ø±Ø¯Ø§Ø®Øª Ú©Ø§Ù…Ù„ ØªØ§ÛŒÛŒØ¯ Ø´Ø¯Ù‡') badgeClass = 'badge-full';
                else if (p.payment_status === 'ÙÛŒØ´ Ø¯Ø± Ø§Ù†ØªØ¸Ø§Ø± Ø¨Ø±Ø±Ø³ÛŒ') badgeClass = 'badge-pending';
                else if (p.payment_status === 'Ø¨ÛŒØ¹Ø§Ù†Ù‡ ØªØ§ÛŒÛŒØ¯ Ø´Ø¯Ù‡') badgeClass = 'badge-deposit';
                else if (p.payment_status === 'Ù¾Ø±Ø¯Ø§Ø®Øª Ù†Ø´Ø¯Ù‡') badgeClass = 'badge-deposit';

const transportDisplay = p.transport_type === 'personal_car' ? 'ðŸš— Ù…Ø§Ø´ÛŒÙ† Ø´Ø®ØµÛŒ' : p.transport_type === 'group_car' ? 'ðŸš™ Ù…Ø§Ø´ÛŒÙ† Ø³Ø§ÛŒØ±ÛŒÙ†' : '-';
                table.innerHTML += `
                    <tr>
                        <td>${index + 1}</td>
                        <td><strong>${p.full_name}</strong></td>
                        <td>${p.national_id || '-'}</td>
                        <td>${p.phone_number || '-'}</td>
<td>${transportDisplay}</td>\n
                        <td><span class="badge ${badgeClass}">${p.payment_status}</span></td>
                        <td>${(p.confirmed_amount || 0).toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                        <td>${(p.remaining_amount || 0).toLocaleString()} ØªÙˆÙ…Ø§Ù†</td>
                    </tr>
                `;
            });
        } catch (err) {
            console.error('Ø®Ø·Ø§ Ø¯Ø± Ø¯Ø±ÛŒØ§ÙØª Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù†:', err);
            statusEl.className = 'payments-error';
            statusEl.textContent = 'âŒ Ø¯Ø±ÛŒØ§ÙØª Ø§Ø·Ù„Ø§Ø¹Ø§Øª Ø´Ø±Ú©Øªâ€ŒÚ©Ù†Ù†Ø¯Ú¯Ø§Ù† Ø¨Ø§ Ø®Ø·Ø§ Ù…ÙˆØ§Ø¬Ù‡ Ø´Ø¯.';
        }
    }

    function closeTripParticipantsModal() {
        const modal = document.getElementById('tripParticipantsModal');
        if (modal) modal.classList.remove('show');
    }

    // Ø«Ø¨Øª Service Worker Ø¨Ø±Ø§ÛŒ PWA
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
                .then(reg => console.log('Service Worker ÙØ¹Ø§Ù„ Ø´Ø¯:', reg.scope))
                .catch(err => console.log('Ø®Ø·Ø§ Ø¯Ø± Service Worker:', err));
        });
    }
</script>
